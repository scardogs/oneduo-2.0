(    voiceMinutesCost: document.getElementById\('voice-minutes-cost'\),) Tj
T* (    smsCost: document.getElementById\('sms-cost'\),) Tj
T* (    workflowsCost: document.getElementById\('workflows-cost'\),) Tj
T* (    totalMonthlyCost: document.getElementById\('total-monthly-cost'\),) Tj
T* (    ) Tj
T* (    // Savings analysis elements) Tj
T* (    currentCostDisplay: document.getElementById\('current-cost-display'\),) Tj
T* (    tatumCostDisplay: document.getElementById\('tatum-cost-display'\),) Tj
T* (    monthlySavings: document.getElementById\('monthly-savings'\),) Tj
T* (    annualSavings: document.getElementById\('annual-savings'\),) Tj
T* (    roiPercentage: document.getElementById\('roi-percentage'\),) Tj
T* (    ) Tj
T* (    // Buttons) Tj
T* (    calculateBtn: document.getElementById\('calculate-btn'\),) Tj
T* (    resetBtn: document.getElementById\('reset-btn'\),) Tj
T* (    printBtn: document.getElementById\('print-btn'\)) Tj
T* (};) Tj
T* () Tj
T* (// Chart instance) Tj
T* (let costComparisonChart = null;) Tj
T* () Tj
T* (// Initialize the calculator) Tj
T* (function initCalculator\(\) {) Tj
T* (    // Set up event listeners) Tj
T* (    elements.missedCallsWeekly.addEventListener\('input', updateMissedCallsMonthly\);) Tj
T* (    elements.calculateBtn.addEventListener\('click', calculateCosts\);) Tj
T* (    elements.resetBtn.addEventListener\('click', resetCalculator\);) Tj
T* (    elements.printBtn.addEventListener\('click', printResults\);) Tj
T* (    ) Tj
T* (    // Initialize the chart) Tj
T* (    initChart\(\);) Tj
T* (    ) Tj
T* (    // Set initial values) Tj
T* (    updateMissedCallsMonthly\(\);) Tj
T* (}) Tj
T* () Tj
T* (// Update missed calls monthly based on weekly value) Tj
T* (function updateMissedCallsMonthly\(\) {) Tj
T* (    const weeklyValue = parseInt\(elements.missedCallsWeekly.value\);) Tj
T* (    elements.missedCallsWeeklyValue.textContent = weeklyValue;) Tj
T* (    ) Tj
T* (    // Calculate monthly value \(weekly * 4\)) Tj
T* (    const monthlyValue = weeklyValue * 4;) Tj
T* (    elements.missedCallsMonthly.textContent = monthlyValue;) Tj
T* (}) Tj
T* () Tj
T* (// Calculate all costs based on input values) Tj
T* (function calculateCosts\(\) {) Tj
T* (    // Get input values) Tj
T* (    const missedCallsMonthly = parseInt\(elements.missedCallsMonthly.textContent\);) Tj
T* (    const avgCallLength = parseFloat\(elements.avgCallLength.value\);) Tj
T* (    const avgSmsSegments = parseInt\(elements.avgSmsSegments.value\);) Tj
T* (    const numLocations = parseInt\(elements.numLocations.value\);) Tj
T* (    const clientsPerLocation = parseInt\(elements.clientsPerLocation.value\);) Tj
T* (    const currentMonthlyCost = parseFloat\(elements.currentMonthlyCost.value\) || 0;) Tj
T* (    ) Tj
ET
