T* ( * Tatum Voice AI Call Center Cost Estimator) Tj
T* ( * JavaScript functionality for the interactive calculator) Tj
T* ( * Based on the calculation logic from the Excel worksheet) Tj
T* ( */) Tj
T* () Tj
T* (// Constants from the Excel worksheet) Tj
T* (const CONSTANTS = {) Tj
T* (    // Base costs) Tj
T* (    LC_PHONE_PER_MIN: 0.0085,) Tj
T* (    AI_PHONE_PER_MIN: 0.13,) Tj
T* (    SMS_SEGMENT: 0.0079,) Tj
T* (    CARRIER_SEGMENT: 0.002,) Tj
T* (    WORKFLOWS_PER_CALL: 0.03,) Tj
T* (    PHONE_NUMBER: 1.25,) Tj
T* (    PREM_WORKFLOWS_PER_LOC: 0,) Tj
T* (    UNLIMITED_AI_PER_LOC: 97,) Tj
T* (    ) Tj
T* (    // Default values) Tj
T* (    DEFAULT_AVG_CALL_LENGTH: 2.5,) Tj
T* (    DEFAULT_AVG_SMS_SEGMENTS: 5,) Tj
T* (    ) Tj
T* (    // Safety factor) Tj
T* (    COST_SAFETY_FACTOR: 0.1) Tj
T* (};) Tj
T* () Tj
T* (// DOM Elements) Tj
T* (const elements = {) Tj
T* (    // Input elements) Tj
T* (    missedCallsWeekly: document.getElementById\('missed-calls-weekly'\),) Tj
T* (    missedCallsWeeklyValue: document.getElementById\('missed-calls-weekly-value'\),) Tj
T* (    missedCallsMonthly: document.getElementById\('missed-calls-monthly'\),) Tj
T* (    avgCallLength: document.getElementById\('avg-call-length'\),) Tj
T* (    avgSmsSegments: document.getElementById\('avg-sms-segments'\),) Tj
T* (    numLocations: document.getElementById\('num-locations'\),) Tj
T* (    clientsPerLocation: document.getElementById\('clients-per-location'\),) Tj
T* (    currentMonthlyCost: document.getElementById\('current-monthly-cost'\),) Tj
T* (    ) Tj
T* (    // Output elements) Tj
T* (    monthlyServiceCost: document.getElementById\('monthly-service-cost'\),) Tj
ET
